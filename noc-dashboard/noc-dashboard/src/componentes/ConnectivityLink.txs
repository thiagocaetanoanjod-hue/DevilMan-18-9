import { Wifi, WifiOff } from 'lucide-react';

interface ConnectivityLinkProps {
  name: string;
  latency: string;
  online: boolean;
  onToggle: () => void;
}

export const ConnectivityLink = ({ name, latency, online, onToggle }: ConnectivityLinkProps) => {
  return (
    <div 
      onClick={onToggle}
      className={`p-4 rounded-xl border cursor-pointer transition-all flex items-center justify-between ${
        online ? 'bg-slate-900 border-slate-800 hover:border-slate-700' : 'bg-red-950/20 border-red-900/50'
      }`}
    >
      <div className="flex items-center space-x-3">
        {online ? <Wifi className="text-emerald-500" size={18} /> : <WifiOff className="text-red-500" size={18} />}
        <div>
          <p className="text-sm font-medium text-white">{name}</p>
          <p className="text-xs text-slate-500">Latência: {online ? latency : 'N/A'}</p>
        </div>
      </div>
      <span className={`text-[10px] px-2 py-1 rounded-full font-bold ${
        online ? 'bg-emerald-500/10 text-emerald-400' : 'bg-red-500/10 text-red-400'
      }`}>
        {online ? 'ONLINE' : 'OFFLINE'}
      </span>
    </div>
  );
};